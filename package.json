{
  "name": "trading-research",
  "private": true,
  "version": "31.8.1",
  "scripts": {
    "build": "node -e \"const fs=require('fs'),p=require('./package.json'),v=p.version;fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});let h=fs.readFileSync('index.html','utf8'),css=fs.readFileSync('styles.css','utf8'),js=fs.readFileSync('app.js','utf8');js=js.replace(/<\\\\/script/gi,'<\\\\\\\\/script');h=h.replace(/<link\\\\s+rel=[\\\\\\\"']stylesheet[\\\\\\\"']\\\\s+href=[\\\\\\\"']styles\\\\.css[\\\\\\\"']\\\\s*\\\\/?\\\\s*>/i,()=>'<style data-tr-build=\\\\\\\"'+v+'\\\\\\\">'+css+'</style>').replace(/<script\\\\s+src=[\\\\\\\"']app\\\\.js[\\\\\\\"']\\\\s*><\\\\/script>/i,()=>'<script data-tr-build=\\\\\\\"'+v+'\\\\\\\">'+js+'</script>');h=h.replace('</head>','  <meta name=\\\\\\\"trading-research-build-version\\\\\\\" content=\\\\\\\"'+v+'\\\\\\\" />\\\\n</head>');fs.writeFileSync('dist/index.html',h)\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
