{
  "name": "trading-research",
  "private": true,
  "version": "11.1.0",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});for(const f of ['index.html','app.js','styles.css'])fs.copyFileSync(f,'dist/'+f)\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}